{
"name": "ai-document-summarizer-chat",
"version": "1.0.0",
"description": "منصة تلخيص المستندات الضخمة (حتى 400 ميغابايت) والمحادثة التفاعلية الذكية باستخدام نماذج Gemini",
"main": "src/server.js",
"type": "module",
"keywords": [
"gemini",
"gemini-flash",
"summarizer",
"ai-chat",
"file-summarizer",
"pdf-summarizer",
"google-genai",
"express",
"large-file-upload"
],
"author": "Smart AI Team",
"license": "MIT",
"engines": {
"node": ">=18.0.0",
"npm": ">=9.0.0"
},
"scripts": {
"start": "node src/server.js",
"dev": "node --watch src/server.js",
"lint": "eslint src//*.js",
"clean:uploads": "node -e "const fs = require('fs'); const path = './uploads'; if (fs.existsSync(path)) fs.readdirSync(path).forEach(f => fs.unlinkSync(path + '/' + f)); console.log('Cleaned uploads directory.');"",
"clean:logs": "node -e "const fs = require('fs'); const path = './logs'; if (fs.existsSync(path)) fs.readdirSync(path).forEach(f => fs.unlinkSync(path + '/' + f)); console.log('Cleaned logs directory.');""
},
"dependencies": {
"@google/genai": "^0.1.1",
"compression": "^1.7.4",
"cors": "^2.8.5",
"dotenv": "^16.4.5",
"express": "^4.19.2",
"helmet": "^7.1.0",
"multer": "^1.4.5-lts.1"
},
"devDependencies": {
"eslint": "^8.57.0",
"prettier": "^3.2.5"
}
}
